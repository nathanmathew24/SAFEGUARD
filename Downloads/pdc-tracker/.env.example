# DocFlow Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# --- Database ---
DATABASE_URL=postgresql://docflow:password@db:5432/docflow
TEST_DATABASE_URL=postgresql://docflow:password@db:5432/docflow_test

# --- Security ---
JWT_SECRET=change-me-to-a-random-256-bit-secret
ENCRYPTION_KEY=change-me-to-a-random-32-byte-key

# --- Flask ---
FLASK_ENV=development
FLASK_APP=run.py

# --- Claude AI ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp ---
WHATSAPP_TOKEN=your-whatsapp-token-here

# --- Rate Limiting (Redis in production) ---
# RATELIMIT_STORAGE_URL=redis://redis:6379/0
