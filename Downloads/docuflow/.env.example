# --- Database ---
DATABASE_URL=postgresql://docuflow:changeme@db:5432/docuflow

# --- Secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Email (pick one provider) ---
EMAIL_PROVIDER=smtp          # smtp | postmark
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM=DocuFlow <no-reply@example.com>
POSTMARK_SERVER_TOKEN=changeme
POSTMARK_FROM=DocuFlow <no-reply@example.com>

# --- WhatsApp (gated add-on — leave blank until a BSP is contracted) ---
WHATSAPP_BSP_PROVIDER=       # twilio | wati | 360dialog | (blank = disabled)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
EXTRACTION_MODEL=claude-opus-4-5-20251101

# --- Upload ---
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760    # 10 MB

# --- Flask env ---
FLASK_ENV=production
